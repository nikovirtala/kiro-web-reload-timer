{
  "manifest_version": 3,
  "name": "Kiro Web Reload Timer",
  "version": "1.1.0",
  "description": "Tracks how often and how long \"Reloading sandbox\" is on screen at app.kiro.dev each day.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "scripting"],
  "host_permissions": ["https://app.kiro.dev/*"],
  "content_scripts": [
    {
      "matches": ["https://app.kiro.dev/*"],
      "js": ["api.js", "content.js"],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "Kiro Web Reload Timer",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
